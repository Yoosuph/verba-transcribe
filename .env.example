# Gemini API Key (Required for live Google services; if omitted, backend operates in fallback simulation mode)
GEMINI_API_KEY=

# Gemini Models
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
GEMINI_FINAL_MODEL=gemini-3.5-transcribe
GEMINI_SUMMARY_MODEL=gemini-pro-latest

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Shared bearer token protecting /api/sessions/* and /ws/*.
# REQUIRED for any deployment beyond local development. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=
# Max LLM-triggering operations per client per minute (0 disables)
RATE_LIMIT_LLM_PER_MINUTE=6

MAX_SESSION_MINUTES=30
MAX_AUDIO_SIZE_MB=100

# --- Persistence -----------------------------------------------------------
# Sessions are stored in SQLite; recordings as WAV files. Both live under DATA_DIR.
DATA_DIR=data
#AUDIO_DIR=data/audio          # default: {DATA_DIR}/audio
#DB_PATH=data/verba.db         # default: {DATA_DIR}/verba.db
# 0 = keep sessions forever
SESSION_RETENTION_DAYS=0
# 0 = keep recordings forever (days; expired WAVs are deleted by the sweep)
AUDIO_RETENTION_DAYS=30

# Simulation mode — ONLY used when GEMINI_API_KEY is empty. With a key present,
# model failures surface as errors instead of silently fabricating output.
MOCK_MODE_IF_NO_KEY=true

# OpenRouter fallback — used only after the Gemini model chain fails (quota/outage).
# Leave empty to disable. Never commit the real key.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODELS=openai/gpt-4o-mini,deepseek/deepseek-chat
